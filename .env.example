# =================================================================
# GOVERNMENT ONE-STOP PORTAL - ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================

# Database Configuration (MySQL Server 8.0)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gov_portal

# SMS Gateway Provider Integration Configuration
# Supported Options: 'fast2sms', 'twilio', 'textlocal', 'console'
SMS_PROVIDER=fast2sms

# SMS Carrier Credentials
SMS_API_KEY=your_sms_api_key_here
SMS_API_SECRET=your_sms_api_secret_here
SMS_SENDER_ID=GOVOTP

# OTP Security & Rate Limiting Rules
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# Server Configuration
PORT=5000
